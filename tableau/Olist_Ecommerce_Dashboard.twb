    <worksheet name='    CX New vs Repeat Delivery'>
      <table>
        <view>
          <datasources>
            <datasource caption='OLIST_Tableau_Master_Dataset_FINAL_VALIDATED' name='federated.1i9tcsm19usxv419ihoz31x11p7t' />
          </datasources>
          <datasource-dependencies datasource='federated.1i9tcsm19usxv419ihoz31x11p7t'>
            <column caption='Late Rate' datatype='real' name='[Calculation_0435104561451010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_late] = 1&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [is_delivered] = 1&#10;    THEN [order_id]&#10;    END&#10;)' />
            </column>
            <column caption='Delivery Health' datatype='string' name='[Calculation_0435104588816390]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Delivery_Status] = &quot;Early&quot; THEN &quot;Early / On-time&quot;&#10;ELSEIF [Delivery_Status] = &quot;Late&quot; THEN &quot;Late&quot;&#10;ELSE &quot;Not Delivered&quot;&#10;END' />
            </column>
            <column caption='CX Customer Type' datatype='string' name='[Calculation_0435104955797532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [customer_order_sequence] = 1 THEN &quot;New Customer&quot;&#10;ELSE &quot;Repeat Customer&quot;&#10;END' />
            </column>
            <column caption='Early/On-Time Rate' datatype='real' name='[Calculation_0435104956280861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [Delivery_Status] = &quot;Early&quot;&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [Delivery_Status] &lt;&gt; &quot;Not Delivered&quot;&#10;    THEN [order_id]&#10;    END&#10;)' />
            </column>
            <column caption='Delivery Status' datatype='string' name='[Delivery_Status]' role='dimension' type='nominal' />
            <column caption='Customer Order Sequence' datatype='integer' name='[customer_order_sequence]' role='measure' type='quantitative' />
            <column caption='Is Delivered' datatype='integer' name='[is_delivered]' role='measure' type='quantitative' />
            <column caption='Is Late' datatype='integer' name='[is_late]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0435104955797532]' derivation='None' name='[none:Calculation_0435104955797532:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_category_name]' derivation='None' name='[none:product_category_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[purchase_date]' derivation='None' name='[none:purchase_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[purchase_month]' derivation='None' name='[none:purchase_month:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Product Category Name' datatype='string' name='[product_category_name]' role='dimension' type='nominal' />
            <column caption='Purchase Date' datatype='date' name='[purchase_date]' role='dimension' type='ordinal' />
            <column caption='Purchase Month' datatype='string' name='[purchase_month]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0435104561451010]' derivation='User' name='[usr:Calculation_0435104561451010:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0435104956280861]' derivation='User' name='[usr:Calculation_0435104956280861:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1i9tcsm19usxv419ihoz31x11p7t].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1i9tcsm19usxv419ihoz31x11p7t].[usr:Calculation_0435104956280861:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1i9tcsm19usxv419ihoz31x11p7t].[usr:Calculation_0435104561451010:qk]&quot;' />
            </groupfilter>
