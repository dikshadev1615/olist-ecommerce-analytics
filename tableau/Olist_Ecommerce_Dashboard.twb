    <worksheet name='Delay Severity Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#898989' fontname='Tableau Bold' fontsize='12'>Late Delivery Severity</run>
            <run fontcolor='#898989' fontname='Tableau Bold' fontsize='12'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='OLIST_Tableau_Master_Dataset_FINAL_VALIDATED' name='federated.1i9tcsm19usxv419ihoz31x11p7t' />
          </datasources>
          <datasource-dependencies datasource='federated.1i9tcsm19usxv419ihoz31x11p7t'>
            <column caption='Delay Severity Bucket' datatype='string' name='[Calculation_0435104639266828]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_late] = 1 THEN&#10;    IF [Delivery_Delay_Days] &lt;= 3 THEN &quot;0–3 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 7 THEN &quot;3–7 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 14 THEN &quot;7–14 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 30 THEN &quot;14–30 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 60 THEN &quot;30–60 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 90 THEN &quot;60–90 days&quot;&#10;    ELSE &quot;&gt;90 days&quot;&#10;    END&#10;END' />
            </column>
            <column caption='Delivery Delay Days' datatype='real' name='[Delivery_Delay_Days]' role='measure' type='quantitative' />
            <column caption='Is Late' datatype='integer' name='[is_late]' role='measure' type='quantitative' />
