          <datasource-dependencies datasource='federated.1i9tcsm19usxv419ihoz31x11p7t'>
            <column caption='KPI 05 - Total Revenue' datatype='real' name='[Calculation_0435104979972128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_revenue_allocated])' />
