              <calculation class='tableau' formula='IF ISNULL([delivery_days]) THEN &quot;Not Delivered&quot;&#10;ELSEIF [delivery_days] &lt;= 3 THEN &quot;0–3 days&quot;&#10;ELSEIF [delivery_days] &lt;= 7 THEN &quot;4–7 days&quot;&#10;ELSEIF [delivery_days] &lt;= 14 THEN &quot;8–14 days&quot;&#10;ELSEIF [delivery_days] &lt;= 30 THEN &quot;15–30 days&quot;&#10;ELSE &quot;&gt;30 days&quot;&#10;END' />
