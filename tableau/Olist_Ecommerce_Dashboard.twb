              <calculation class='tableau' formula='SUM([order_review_score_allocated])&#10;/&#10;SUM([order_review_flag_allocated])' />
            </column>
            <column caption='Delivery Health' datatype='string' name='[Calculation_0435104588816390]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Delivery_Status] = &quot;Early&quot; THEN &quot;Early / On-time&quot;&#10;ELSEIF [Delivery_Status] = &quot;Late&quot; THEN &quot;Late&quot;&#10;ELSE &quot;Not Delivered&quot;&#10;END' />
