      <aliases enabled='yes' />
      <column caption='Approval Delay Hours' datatype='real' name='[Approval_Delay_Hours]' role='measure' type='quantitative' />
      <column caption='KPI - Orders' datatype='integer' name='[Calculation_0435104561311744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='KPI - Delivered Orders' datatype='integer' name='[Calculation_0435104561389569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [is_delivered] = 1&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Late Rate' datatype='real' name='[Calculation_0435104561451010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [is_late] = 1&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [is_delivered] = 1&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Late Value' datatype='real' name='[Calculation_0435104561590275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late_item_revenue])' />
      </column>
      <column caption='KPI - Avg Review' datatype='real' name='[Calculation_0435104561664004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_review_score_allocated])&#10;/&#10;SUM([order_review_flag_allocated])' />
      </column>
      <column caption='KPI - Repeat Rate' datatype='real' name='[Calculation_0435104561725445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_order_sequence] &gt; 1&#10;    THEN [customer_unique_id]&#10;    END&#10;)&#10;/&#10;COUNTD([customer_unique_id])' />
      </column>
      <column caption='Delivery Health' datatype='string' name='[Calculation_0435104588816390]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Status] = &quot;Early&quot; THEN &quot;Early / On-time&quot;&#10;ELSEIF [Delivery_Status] = &quot;Late&quot; THEN &quot;Late&quot;&#10;ELSE &quot;Not Delivered&quot;&#10;END' />
      </column>
      <column caption='KPI - Avg Delivery Days' datatype='real' name='[Calculation_0435104627462153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([delivery_days])' />
      </column>
      <column caption='KPI - Avg Late Delay' datatype='real' name='[Calculation_0435104627572746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    IF [is_late] = 1 THEN [Delivery_Delay_Days] END&#10;)' />
      </column>
      <column caption='KPI - Avg Handover Days' datatype='real' name='[Calculation_0435104631447563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Carrier_Handover_Days_Clean])' />
      </column>
      <column caption='Delay Severity Bucket' datatype='string' name='[Calculation_0435104639266828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_late] = 1 THEN&#10;    IF [Delivery_Delay_Days] &lt;= 3 THEN &quot;0–3 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 7 THEN &quot;3–7 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 14 THEN &quot;7–14 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 30 THEN &quot;14–30 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 60 THEN &quot;30–60 days&quot;&#10;    ELSEIF [Delivery_Delay_Days] &lt;= 90 THEN &quot;60–90 days&quot;&#10;    ELSE &quot;&gt;90 days&quot;&#10;    END&#10;END' />
      </column>
      <column caption='Delivery Time Bucket' datatype='string' name='[Calculation_0435104642600973]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([delivery_days]) THEN &quot;Not Delivered&quot;&#10;ELSEIF [delivery_days] &lt;= 3 THEN &quot;0–3 days&quot;&#10;ELSEIF [delivery_days] &lt;= 7 THEN &quot;4–7 days&quot;&#10;ELSEIF [delivery_days] &lt;= 14 THEN &quot;8–14 days&quot;&#10;ELSEIF [delivery_days] &lt;= 30 THEN &quot;15–30 days&quot;&#10;ELSE &quot;&gt;30 days&quot;&#10;END' />
      </column>
      <column caption='KPI Priority 1 Sellers' datatype='integer' name='[Calculation_0435104826826767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [seller_intervention_priority] = &quot;PRIORITY 1 - Immediate Intervention&quot;&#10;    THEN [seller_id]&#10;    END&#10;)' />
      </column>
      <column caption='KPI - Priority 2 Sellers' datatype='integer' name='[Calculation_0435104826937360]' role='measure' type='quantitative'>
